{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "firebase-applet-config.json"],
  "exclude": [
    "src/App.tsx",
    "src/App.jsx",
    "src/main.jsx",
    "src/components/DressMeInBalmain.tsx",
    "src/components/RealTimeAvatar.tsx",
    "src/components/LandingLVT.tsx",
    "src/divineo/pauV11/**",
    "src/divineo/setupDivineoCamera.ts"
  ]
}
